<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender for container environments -->
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger - INFO level for production performance -->
    <root level="INFO">
        <appender-ref ref="STDOUT" />
    </root>

    <!-- Framework loggers - reduced verbosity for performance -->
    <logger name="com.networknt" level="WARN"/>
    <logger name="io.undertow" level="WARN"/>
    <logger name="com.zaxxer.hikari" level="WARN"/>

    <!-- Application logger -->
    <logger name="org.sandcastle.apps" level="INFO"/>
</configuration>
